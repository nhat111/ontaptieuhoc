NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://zophnkacxzfqzpihirxv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3L28eqPy64Q5v95Z-PwvKA_2ftOtSWU

# Absolute site URL, used for sitemap.xml / robots.txt and canonical + Open Graph
# tags. Falls back to the Vercel deployment URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Chỉ cần cho POST /api/ocr-exam (quét ảnh đề bằng Claude vision).
# Thiếu biến này thì route trả 503, các tính năng khác vẫn chạy bình thường.
ANTHROPIC_API_KEY=sk-ant-...

# Chỉ cần cho POST /api/tts (giọng đọc tiếng Anh tự nhiên cho đề tiếng Anh).
# Thiếu biến này thì GET /api/tts trả { available: false } và trang quiz tự dùng
# giọng máy của trình duyệt — không hỏng gì, chỉ là giọng máy móc hơn.
# File audio được cache theo nội dung trong Supabase Storage nên mỗi câu chỉ tốn
# tiền đúng một lần, nghe lại bao nhiêu lần cũng miễn phí.
OPENAI_API_KEY=sk-...
