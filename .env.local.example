# Absolute site URL, used for sitemap.xml / robots.txt and canonical + Open Graph
# tags. Falls back to the Vercel deployment URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Chỉ cần cho POST /api/ocr-exam (quét ảnh đề bằng Claude vision).
# Thiếu biến này thì route trả 503, các tính năng khác vẫn chạy bình thường.
ANTHROPIC_API_KEY=sk-ant-...

# Mật khẩu chung để vào khu soạn nội dung (/import*) và các API ghi dữ liệu.
# BỎ TRỐNG thì mọi thứ mở như trước — tiện cho môi trường dev.
# Nên đặt ở production: /api/update-lesson xoá sạch câu hỏi rồi chèn lại, nên ai
# đoán được mã đề là xoá trắng được nội dung, mà không có bản sao lưu nào.
IMPORT_PASSWORD=
